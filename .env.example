# ShadowTrace Environment Configuration

# Application Port (Render automatically supplies PORT)
PORT=3000

# Google Gemini API Key (Gemini 2.0 Flash)
# If left empty, ShadowTrace automatically falls back to its deterministic local heuristic threat engine
GEMINI_API_KEY=

# Supabase Configuration
# If left empty, ShadowTrace operates with an in-memory session engine for zero-friction local audits
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
